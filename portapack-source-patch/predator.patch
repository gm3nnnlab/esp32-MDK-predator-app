+// --- Predator app support --------------------------------------------------
+
+bool I2cDev_PPmod::predator_wifi_start_scan() {
+    if (isLocked()) return false;
+    Command cmd = Command::COMMAND_PREDATOR_WIFI_STARTSCAN;
+    return i2c_read((uint8_t*)&cmd, 2, nullptr, 0);
+}
+
+bool I2cDev_PPmod::predator_wifi_stop_scan() {
+    if (isLocked()) return false;
+    Command cmd = Command::COMMAND_PREDATOR_WIFI_STOPSCAN;
+    return i2c_read((uint8_t*)&cmd, 2, nullptr, 0);
+}
+
+std::optional<I2cDev_PPmod::predator_wifi_record_t> I2cDev_PPmod::predator_wifi_get_result(uint16_t index) {
+    if (isLocked()) return std::nullopt;
+    // Low 16 bits: command. High 16 bits: requested record index. Same packing
+    // convention as COMMAND_APP_INFO above.
+    uint32_t data = (uint32_t)Command::COMMAND_PREDATOR_WIFI_GETRESULT + ((uint32_t)index << 16);
+    I2cDev_PPmod::predator_wifi_record_t rec{};
+    bool success = i2c_read((uint8_t*)&data, sizeof(data), (uint8_t*)&rec, sizeof(rec));
+    if (!success) return std::nullopt;
+    rec.ssid[sizeof(rec.ssid) - 1] = 0;  // never trust the far end for termination
+    return rec;
+}
+
+bool I2cDev_PPmod::predator_ble_start_scan() {
+    if (isLocked()) return false;
+    Command cmd = Command::COMMAND_PREDATOR_BLE_STARTSCAN;
+    return i2c_read((uint8_t*)&cmd, 2, nullptr, 0);
+}
+
+bool I2cDev_PPmod::predator_ble_stop_scan() {
+    if (isLocked()) return false;
+    Command cmd = Command::COMMAND_PREDATOR_BLE_STOPSCAN;
+    return i2c_read((uint8_t*)&cmd, 2, nullptr, 0);
+}
+
+std::optional<I2cDev_PPmod::predator_ble_record_t> I2cDev_PPmod::predator_ble_get_result(uint16_t index) {
+    if (isLocked()) return std::nullopt;
+    uint32_t data = (uint32_t)Command::COMMAND_PREDATOR_BLE_GETRESULT + ((uint32_t)index << 16);
+    I2cDev_PPmod::predator_ble_record_t rec{};
+    bool success = i2c_read((uint8_t*)&data, sizeof(data), (uint8_t*)&rec, sizeof(rec));
+    if (!success) return std::nullopt;
+    rec.name[sizeof(rec.name) - 1] = 0;
+    return rec;
+}
